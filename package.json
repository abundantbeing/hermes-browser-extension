{
  "name": "hermes-browser-extension",
  "version": "0.4.0",
  "private": true,
  "description": "Browser-native side panel for Hermes Agent — connect web context to your local or remote Hermes runtime.",
  "type": "module",
  "author": "Jon Komet",
  "license": "MIT",
  "homepage": "https://github.com/abundantbeing/hermes-browser-extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/abundantbeing/hermes-browser-extension.git"
  },
  "bugs": {
    "url": "https://github.com/abundantbeing/hermes-browser-extension/issues"
  },
  "scripts": {
    "pretest": "npm run build:firefox",
    "test": "node --test tests/*.test.mjs",
    "check:js": "node scripts/check-js.mjs",
    "check:content-runtime": "node scripts/build-content-runtime.mjs --check",
    "check:voice": "node --check extension/lib/voice-wingbeat.mjs",
    "check:self-contained": "node scripts/check-self-contained.mjs",
    "vendor:security": "node scripts/vendor-security-libs.mjs",
    "audit": "npm audit",
    "check:security": "npm run lint && npm run audit",
    "generate:browser-locales": "node scripts/generate-browser-locales.mjs",
    "sync:contexts": "node scripts/sync-hermes-context-windows.mjs",
    "check:contexts": "node scripts/sync-hermes-context-windows.mjs --check",
    "check:i18n": "node scripts/generate-browser-locales.mjs --check && node scripts/check-i18n.mjs",
    "check:manifest": "npm run check:i18n && node scripts/check-manifest.mjs",
    "verify": "npm run test && npm run check:js && npm run check:voice && npm run check:manifest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:content-runtime": "node scripts/build-content-runtime.mjs",
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "lint:firefox": "web-ext lint --self-hosted --source-dir dist/firefox",
    "sign:firefox": "web-ext sign --channel=listed --source-dir dist/firefox --artifacts-dir artifacts",
    "sign:firefox:unlisted": "web-ext sign --channel=unlisted --source-dir dist/firefox --artifacts-dir artifacts",
    "setup:windows": "node scripts/windows-setup.mjs",
    "setup:windows:dry-run": "node scripts/windows-setup.mjs --dry-run --json",
    "package": "npm run build && npm run build:firefox && node scripts/package.mjs",
    "review:event": "node scripts/hermes-review-github-event.mjs",
    "review:event:dry-run": "node scripts/hermes-review-github-event.mjs --dry-run",
    "review:watch": "node scripts/hermes-review-watch.mjs",
    "review:watch:dry-run": "node scripts/hermes-review-watch.mjs --dry-run",
    "test:pytools": "python -m unittest discover -s tests/pytools",
    "bench:startup": "node scripts/bench-startup.mjs",
    "test:hover-guard": "npm run build && node -e \"process.env.HOVER_GUARD_ONLY='1'; import('./tests/e2e-effort-slider.mjs')\"",
    "test:e2e:loaded": "npm run build && node tests/e2e-loaded-extension.mjs",
    "test:e2e:voice": "npm run build && node tests/e2e-voice-wingbeat.mjs",
    "test:e2e:voice-live": "npm run build && node tests/e2e-voice-live.mjs",
    "test:verify:issue73": "npm run build && node tests/verify-issue73-menu-layout.mjs",
    "test:e2e:controller": "npm run build && node tests/e2e-controller-lifecycle.mjs",
    "test:e2e:browser-control": "npm run build && node tests/e2e-phase6-browser-control.mjs && node tests/e2e-phase6-browser-control-reconnect.mjs && node tests/e2e-phase6-agent-route.mjs && node tests/e2e-phase6-child-frames.mjs && node tests/e2e-phase6-youtube-like.mjs",
    "test:e2e:browser-control:reconnect": "npm run build && node tests/e2e-phase6-browser-control-reconnect.mjs",
    "test:e2e:browser-control:agent-route": "npm run build && node tests/e2e-phase6-agent-route.mjs",
    "test:e2e:browser-control:child-frames": "npm run build && node tests/e2e-phase6-child-frames.mjs",
    "test:e2e:browser-control:youtube": "npm run build && node tests/e2e-phase6-youtube-like.mjs",
    "test:e2e:prompt-cards": "npm run build && node tests/e2e-agent-prompt-cards.mjs",
    "test:e2e:page-annotation": "npm run build:content-runtime && node tests/e2e-page-annotation.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^30.0.1",
    "linkedom": "0.18.12",
    "web-ext": "^10.6.0"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "highlight.js": "11.12.0"
  }
}
